# Fifth Stone Connect — environment template
# Copy to .env for local development. Never commit .env.
# Every value below is a placeholder. Real values live in the deployment secret store.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
# Public base URL of the API (used to build hosted form and status links)
PUBLIC_BASE_URL=http://localhost:3000
API_PORT=3000

# --- Database (Supabase-managed Postgres; server-side only) ---
# Use a dedicated application role, not the Supabase service_role key.
# Local/test database must be NON-PRODUCTION.
DATABASE_URL=postgres://app_user:CHANGE_ME@localhost:5432/fifth_stone_connect_dev
DATABASE_URL_TEST=postgres://app_user:CHANGE_ME@localhost:5432/fifth_stone_connect_test

# --- Amazon SES (existing provider) ---
AWS_REGION=us-east-1
# Prefer an IAM role or scoped IAM user limited to ses:SendEmail on approved identities.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
SES_CONFIGURATION_SET=CHANGE_ME
# Safety switch: when true, the SES adapter refuses to send (dev/test default).
SES_SEND_DISABLED=true

# --- Google Sheets ---
# Path to service-account JSON stored OUTSIDE the repo, or injected by the secret store.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/run/secrets/google-service-account.json

# --- Cloudflare Turnstile ---
# Cloudflare publishes official test keys for development; production keys come from the dashboard.
TURNSTILE_SECRET_KEY=CHANGE_ME

# --- Webhook signing ---
# Per-source signing secrets are stored per tenant connection, not here.
WEBHOOK_REPLAY_WINDOW_SECONDS=300

# --- Operator ---
# Required by operator CLI commands that change data; prevents accidental runs against the wrong DB.
OPERATOR_CONFIRM_ENV=development
